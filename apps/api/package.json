{
  "name": "@meetingmate/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "uvicorn meetingmate.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "python -m compileall src",
    "lint": "ruff check src tests",
    "typecheck": "mypy src",
    "test": "pytest",
    "db:migrate": "alembic upgrade head",
    "db:revision": "alembic revision --autogenerate -m"
  }
}
